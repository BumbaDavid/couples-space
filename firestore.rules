rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isCoupleMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
                  || (isSignedIn()
                      && resource.data.coupleId != null
                      && resource.data.coupleId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId);
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if false;

      match /sharedNotes/{noteId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      // Shared food catalog for the protein tracker. Food facts are shared
      // knowledge; the log built from them is private (see proteinLog below).
      match /foods/{foodId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

    match /users/{userId}/privateNotes/{noteId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/exercises/{exerciseId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/exercises/{exerciseId}/entries/{entryId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId}/days/{dayId} {
      allow read, write: if isSelf(userId);
    }

    // Protein log. Self-only, with no cross-partner read — deliberately
    // stricter than users/{userId} itself, which a paired partner CAN read.
    // Never relax this: the whole feature depends on the log being private.
    match /users/{userId}/proteinLog/{entryId} {
      allow read, write: if isSelf(userId);
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn();
      allow update: if false;
    }
  }
}
